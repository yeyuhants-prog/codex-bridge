{
  "command": "node",
  "args": ["main.mjs"],
  "env": {
    "CODEX_PANEL_VERSION": "1.3.0"
  },
  "restart_policy": "always",
  "display_name": "Codex Bridge",
  "description": "Interactive control panel & goal progression board (EN/中文): select Codex model, reasoning effort, sandbox, progression mode, and track persistent goals & background jobs.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "Codex Bridge",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Codex Bridge"
      }
    ]
  }
}
