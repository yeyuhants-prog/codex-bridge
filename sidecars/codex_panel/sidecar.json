{
  "command": "node",
  "args": ["main.mjs"],
  "env": {
    "CODEX_PANEL_VERSION": "1.5.0"
  },
  "restart_policy": "always",
  "display_name": "Codex Bridge",
  "description": "Mastermind & Codex Worker control panel (EN/中文): role division, model/effort/sandbox controls, persistent goal board, per-job locked callbacks & cross-process session locks.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": true
  },
  "ui_config": {
    "display_name": "Codex Bridge",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Codex Bridge"
      }
    ]
  }
}
